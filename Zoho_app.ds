/*
 * Application  : CivicLane - AI Urban Infrastructure & Issue Management
 * Architecture : 100% Native Zoho Creator Built-in AI Microservices & Deluge Workflows
 */

application "CivicLane"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"

	section Operations_And_Crew
	{
		displayname = "1. Departments, Crew & AI Setup"
		icon = "users-2"

		form Departments
		{
			displayname = "Municipal Departments"
			success message = "Municipal Department saved successfully."

			Department_Name
			(
				type = text
				displayname = "Department Name"
				must have
				row = 1
				column = 1
				width = medium
			)
			Department_Code
			(
				type = text
				displayname = "Department Code"
				must have
				row = 1
				column = 1
				width = medium
			)
			Handled_AI_Category
			(
				type = picklist
				displayname = "Primary AI Category Handled"
				must have
				values = {"Pothole & Road Damage", "Damaged Streetlight", "Water Leakage & Drainage", "Improper Waste Disposal", "Public Safety Hazard"}
				row = 1
				column = 1
				width = medium
			)
			SLA_Target_Hours
			(
				type = number
				displayname = "Target SLA Resolution (Hours)"
				must have
				defaultvalue = 24
				row = 1
				column = 2
				width = medium
			)
			Department_Head_Email
			(
				type = email
				displayname = "Commissioner / Escalation Email"
				must have
				row = 1
				column = 2
				width = medium
			)
			Active_Department
			(
				type = decision box
				displayname = "Department Active"
				defaultvalue = true
				row = 1
				column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Save Department"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update Department"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		default list All_Departments
		{
			displayname = "Municipal Departments Directory"
			show all rows from Departments
			(
				Department_Code
				Department_Name
				Handled_AI_Category
				SLA_Target_Hours
				Department_Head_Email
				Active_Department
			)
		}

		form Field_Engineers
		{
			displayname = "Field Engineers & Crew"
			success message = "Field Engineer profile saved successfully."

			Engineer_Name
			(
				type = text
				displayname = "Engineer Full Name"
				must have
				row = 1
				column = 1
				width = medium
			)
			Engineer_Email
			(
				type = email
				displayname = "Official Email"
				must have
				row = 1
				column = 1
				width = medium
			)
			Engineer_Phone
			(
				type = phonenumber
				displayname = "Contact Phone"
				must have
				row = 1
				column = 1
				width = medium
			)
			Department_Ref
			(
				type = picklist
				displayname = "Assigned Department"
				must have
				values = Departments.ID
				displayformat = [Department_Name]
				row = 1
				column = 2
				width = medium
			)
			Primary_Ward
			(
				type = picklist
				displayname = "Assigned Municipal Ward"
				must have
				values = {"Ward 01 - Central Business District", "Ward 02 - North Residential Zone", "Ward 03 - Industrial & Logistics Corridor", "Ward 04 - South Tech Park & IT Zone", "Ward 05 - East Coastal & Harbour Zone"}
				row = 1
				column = 2
				width = medium
			)
			Availability_Status
			(
				type = picklist
				displayname = "Duty Status"
				values = {"Available", "On Field", "Off Duty"}
				defaultvalue = "Available"
				row = 1
				column = 2
				width = medium
			)
			Current_Active_Load
			(
				type = number
				displayname = "Active Assigned Issues"
				defaultvalue = 0
				row = 1
				column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Add Field Engineer"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update Engineer"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		default list All_Field_Engineers
		{
			displayname = "Field Engineers Workload Roster"
			show all rows from Field_Engineers
			(
				Engineer_Name
				Department_Ref
				Primary_Ward
				Availability_Status
				Current_Active_Load
				Engineer_Phone
				Engineer_Email
			)
			group by
			(
				Primary_Ward ascending
			)
		}

		form AI_Model_Dataset
		{
			displayname = "AI Microservice Training Dataset"
			success message = "AI Training Record added."

			Sample_Description
			(
				type = textarea
				displayname = "Training Issue Text"
				must have
				row = 1
				column = 1
				width = medium
			)
			Ward_Zone
			(
				type = picklist
				displayname = "Municipal Ward"
				values = {"Ward 01 - Central Business District", "Ward 02 - North Residential Zone", "Ward 03 - Industrial & Logistics Corridor", "Ward 04 - South Tech Park & IT Zone", "Ward 05 - East Coastal & Harbour Zone"}
				row = 1
				column = 1
				width = medium
			)
			Landmark_Type
			(
				type = picklist
				displayname = "Nearest Landmark"
				values = {"Hospital / Clinic", "School / University", "Highway / Arterial Road", "Residential Street", "Commercial Market", "Park / Public Utility"}
				row = 1
				column = 1
				width = medium
			)
			Labeled_Category
			(
				type = picklist
				displayname = "Target AI Category (Label)"
				values = {"Pothole & Road Damage", "Damaged Streetlight", "Water Leakage & Drainage", "Improper Waste Disposal", "Public Safety Hazard"}
				row = 1
				column = 2
				width = medium
			)
			Vision_Object_Class
			(
				type = text
				displayname = "Object Detection Class Tag"
				row = 1
				column = 2
				width = medium
			)
			Labeled_Priority
			(
				type = picklist
				displayname = "Target Priority Level (Label)"
				values = {"Critical", "High", "Medium", "Low"}
				row = 1
				column = 2
				width = medium
			)
			Historical_Resolution_Hours
			(
				type = number
				displayname = "Actual Resolution Time (Hours)"
				defaultvalue = 12
				row = 1
				column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Add Training Sample"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update Sample"
					)
				}
			}
		}

		default list All_AI_Training_Data
		{
			displayname = "Built-In AI Microservice Training Corpus"
			show all rows from AI_Model_Dataset
			(
				Labeled_Category
				Vision_Object_Class
				Landmark_Type
				Ward_Zone
				Labeled_Priority
				Historical_Resolution_Hours
				Sample_Description
			)
			group by
			(
				Labeled_Category ascending
			)
		}

		form Demo_Data_Seeder
		{
			displayname = "Initialize CivicLane Demo Data"
			success message = "CivicLane Database & AI Microservice Corpus initialized successfully!"

			Execution_Batch_Name
			(
				type = text
				displayname = "Initialization Profile"
				defaultvalue = "Full Municipal Demo Dataset + AI Training Corpus"
				row = 1
				column = 1
				width = medium
			)
			Reset_Existing_Data
			(
				type = decision box
				displayname = "Clear existing records before seeding fresh demo data"
				defaultvalue = true
				row = 1
				column = 1
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Click Here to Generate All Demo Data"
					)
				}
			}
		}
	}

	section Citizen_Issue_Management
	{
		displayname = "2. Civic Issue Reporting & AI Triage"
		icon = "location-pin"

		form Civic_Issues
		{
			displayname = "Report Civic Issue"
			success message = "Issue logged and triaged by CivicLane Built-in AI Microservice!"

			Section_Citizen_Info
			(
				type = section
				displayname = "1. Citizen Reporter Details"
				row = 1
				column = 0
				width = medium
			)
			Ticket_Number
			(
				type = autonumber
				displayname = "Ticket ID"
				start index = 1001
				row = 1
				column = 1
				width = medium
			)
			Citizen_Name
			(
				type = text
				displayname = "Citizen Full Name"
				must have
				row = 1
				column = 1
				width = medium
			)
			Citizen_Email
			(
				type = email
				displayname = "Email Address"
				must have
				row = 1
				column = 2
				width = medium
			)
			Citizen_Phone
			(
				type = phonenumber
				displayname = "Mobile Number"
				must have
				row = 1
				column = 2
				width = medium
			)

			Section_Issue_Details
			(
				type = section
				displayname = "2. Infrastructure Issue, Photo & Geo-Location"
				row = 2
				column = 0
				width = medium
			)
			Issue_Title
			(
				type = text
				displayname = "Issue Summary / Headline"
				must have
				row = 2
				column = 1
				width = medium
			)
			Issue_Description
			(
				type = textarea
				displayname = "Detailed Description"
				must have
				height = 100px
				row = 2
				column = 1
				width = medium
			)
			Issue_Photograph
			(
				type = image
				displayname = "Upload Issue Photograph (For AI Object Detection)"
				source = file,camera
				aspect ratio = original
				row = 2
				column = 1
				width = medium
			)
			Ward_Zone
			(
				type = picklist
				displayname = "Municipal Ward / Zone"
				must have
				values = {"Ward 01 - Central Business District", "Ward 02 - North Residential Zone", "Ward 03 - Industrial & Logistics Corridor", "Ward 04 - South Tech Park & IT Zone", "Ward 05 - East Coastal & Harbour Zone"}
				row = 2
				column = 2
				width = medium
			)
			Landmark_Type
			(
				type = picklist
				displayname = "Nearest Public Landmark Type"
				values = {"Hospital / Clinic", "School / University", "Highway / Arterial Road", "Residential Street", "Commercial Market", "Park / Public Utility"}
				defaultvalue = "Residential Street"
				row = 2
				column = 2
				width = medium
			)
			Raw_Location_Address
			(
				type = textarea
				displayname = "Street Address / Location Landmark"
				must have
				height = 60px
				row = 2
				column = 2
				width = medium
			)
			Latitude
			(
				type = decimal
				displayname = "GPS Latitude"
				decimalplace = 6
				defaultvalue = 13.082680
				row = 2
				column = 2
				width = medium
			)
			Longitude
			(
				type = decimal
				displayname = "GPS Longitude"
				decimalplace = 6
				defaultvalue = 80.270718
				row = 2
				column = 2
				width = medium
			)

			Section_AI_Triage
			(
				type = section
				displayname = "3. Built-In AI Microservice Output (Auto-Computed)"
				row = 3
				column = 0
				width = medium
			)
			AI_Category
			(
				type = picklist
				displayname = "AI Predicted Category"
				values = {"Pothole & Road Damage", "Damaged Streetlight", "Water Leakage & Drainage", "Improper Waste Disposal", "Public Safety Hazard", "Unclassified"}
				defaultvalue = "Unclassified"
				row = 3
				column = 1
				width = medium
			)
			AI_Confidence
			(
				type = decimal
				displayname = "AI Model Confidence (%)"
				decimalplace = 1
				defaultvalue = 0.0
				row = 3
				column = 1
				width = medium
			)
			AI_Detected_Objects
			(
				type = text
				displayname = "AI Object Detection & Keyword Tags"
				row = 3
				column = 1
				width = medium
			)
			AI_Sentiment
			(
				type = text
				displayname = "AI Citizen Sentiment & Urgency"
				row = 3
				column = 1
				width = medium
			)
			Priority_Score
			(
				type = number
				displayname = "AI Priority Score (0-100)"
				defaultvalue = 50
				row = 3
				column = 2
				width = medium
			)
			Priority_Level
			(
				type = picklist
				displayname = "AI Predicted Priority Level"
				values = {"Critical", "High", "Medium", "Low"}
				defaultvalue = "Medium"
				row = 3
				column = 2
				width = medium
			)
			Is_Duplicate
			(
				type = decision box
				displayname = "Flagged as Duplicate by Spatial AI"
				defaultvalue = false
				row = 3
				column = 2
				width = medium
			)
			Master_Issue_Ticket
			(
				type = text
				displayname = "Linked Master Ticket ID"
				row = 3
				column = 2
				width = medium
			)
			Duplicate_Count
			(
				type = number
				displayname = "Clustered Citizen Reports Count"
				defaultvalue = 1
				row = 3
				column = 2
				width = medium
			)

			Section_Assignment_Resolution
			(
				type = section
				displayname = "4. Automated Routing, SLA & Resolution Verification"
				row = 4
				column = 0
				width = medium
			)
			Issue_Status
			(
				type = picklist
				displayname = "Current Resolution Status"
				values = {"Reported", "AI Triaged", "Assigned", "In Progress", "Escalated", "Resolved", "Closed - Duplicate"}
				defaultvalue = "Reported"
				row = 4
				column = 1
				width = medium
			)
			Assigned_Department
			(
				type = picklist
				displayname = "Assigned Municipal Department"
				values = Departments.ID
				displayformat = [Department_Name]
				row = 4
				column = 1
				width = medium
			)
			Assigned_Engineer
			(
				type = picklist
				displayname = "Assigned Field Engineer"
				values = Field_Engineers.ID
				displayformat = [Engineer_Name]
				row = 4
				column = 1
				width = medium
			)
			SLA_Deadline
			(
				type = datetime
				displayname = "Target SLA Resolution Deadline"
				row = 4
				column = 1
				width = medium
			)
			SLA_Breached
			(
				type = decision box
				displayname = "SLA Breached"
				defaultvalue = false
				row = 4
				column = 1
				width = medium
			)
			Resolution_Notes
			(
				type = textarea
				displayname = "Field Engineer Resolution Notes"
				height = 80px
				row = 4
				column = 2
				width = medium
			)
			Resolution_Proof_Photo
			(
				type = image
				displayname = "Post-Repair Verification Photograph"
				source = file,camera
				row = 4
				column = 2
				width = medium
			)
			Resolved_On
			(
				type = datetime
				displayname = "Resolved Timestamp"
				row = 4
				column = 2
				width = medium
			)
			Citizen_Feedback_Rating
			(
				type = picklist
				displayname = "Citizen Satisfaction Rating"
				values = {"5 - Excellent", "4 - Good", "3 - Average", "2 - Poor", "1 - Unacceptable"}
				row = 4
				column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit Issue to CivicLane AI"
					)
					reset
					(
						type = reset
						displayname = "Clear Form"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update Issue Record"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		default list All_Civic_Issues
		{
			displayname = "Master AI Triage & Issue Tracker"
			show all rows from Civic_Issues
			(
				Ticket_Number
				Issue_Title
				Ward_Zone
				AI_Category
				AI_Confidence
				Priority_Level
				Priority_Score
				Issue_Status
				Duplicate_Count
				Assigned_Department
				Assigned_Engineer
				SLA_Deadline
				SLA_Breached
				Citizen_Name
			)
			group by
			(
				Ward_Zone ascending
			)
		}

		list Critical_And_Escalated_Issues
		{
			displayname = "Critical & SLA-Escalated Priority Queue"
			show all rows from Civic_Issues [Priority_Level == "Critical" || SLA_Breached == true]
			(
				Ticket_Number
				Issue_Title
				Ward_Zone
				Landmark_Type
				AI_Category
				Priority_Score
				Issue_Status
				Assigned_Department
				Assigned_Engineer
				SLA_Deadline
				SLA_Breached
			)
			group by
			(
				Priority_Level ascending
			)
		}

		list AI_Duplicate_Clusters
		{
			displayname = "AI Duplicate Detection & Clustered Reports"
			show all rows from Civic_Issues [Is_Duplicate == true || Duplicate_Count > 1]
			(
				Ticket_Number
				Issue_Title
				Ward_Zone
				AI_Category
				Is_Duplicate
				Master_Issue_Ticket
				Duplicate_Count
				Priority_Score
				Issue_Status
			)
		}

		list Citizen_Issue_Tracker
		{
			displayname = "Public Citizen Transparency Board"
			show all rows from Civic_Issues [Is_Duplicate == false]
			(
				Ticket_Number
				Issue_Title
				Ward_Zone
				AI_Category
				Priority_Level
				Duplicate_Count
				Issue_Status
				Assigned_Department
				SLA_Deadline
				Resolved_On
				Citizen_Feedback_Rating
			)
			group by
			(
				Issue_Status ascending
			)
		}

		form Issue_Activity_Logs
		{
			displayname = "Issue Activity & Audit Log"
			success message = "Audit log entry recorded."

			Ticket_Ref
			(
				type = text
				displayname = "Ticket Number"
				row = 1
				column = 1
				width = medium
			)
			Action_Stage
			(
				type = text
				displayname = "Workflow Stage / Event"
				row = 1
				column = 1
				width = medium
			)
			Actor_Details
			(
				type = text
				displayname = "Executed By Microservice / User"
				row = 1
				column = 1
				width = medium
			)
			Log_Timestamp
			(
				type = datetime
				displayname = "Event Timestamp"
				row = 1
				column = 2
				width = medium
			)
			Audit_Notes
			(
				type = textarea
				displayname = "Detailed Audit Notes"
				height = 70px
				row = 1
				column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Add Audit Log"
					)
				}
			}
		}

		default list All_Activity_Logs
		{
			displayname = "Automated Workflow & AI Audit Trail"
			show all rows from Issue_Activity_Logs
			(
				Ticket_Ref
				Action_Stage
				Actor_Details
				Log_Timestamp
				Audit_Notes
			)
		}
	}

	section Command_Dashboards
	{
		displayname = "3. Executive Dashboards & Portals"
		icon = "design-2-layout-grid"

		page CivicLane_Command_Center
		{
			displayname = "Executive Command Center"
			icon = "business-chart-bar-32"
			Content = "<page><layout><row><column width='100%'><panel elementName='Hero_Banner'><pr height='fill' width='fill'><pc bgColor='#0F172A' padding='24px' width='100%'><pr><pc><text value='CIVICLANE — AI URBAN INFRASTRUCTURE COMMAND CENTER' color='#38BDF8' size='13px' bold='true' /></pc></pr><pr><pc><text value='Built-In Zoho AI Microservices for Automated Issue Classification, Spatial Duplicate Clustering &amp; SLA Dispatch' color='#FFFFFF' size='20px' bold='true' /></pc></pr></pc></pr></panel></column></row><row><column width='25%'><panel elementName='Card_1'><pr height='fill' width='fill'><pc bgColor='#1E293B' padding='18px' width='100%'><pr><pc><text value='AI VISION &amp; NLP CLASSIFIER' color='#38BDF8' size='11px' bold='true' /></pc></pr><pr><pc><text value='Auto-Categorization Active' color='#FFFFFF' size='16px' bold='true' /></pc></pr><pr><pc><text value='Potholes, Streetlights, Water, Waste' color='#94A3B8' size='12px' /></pc></pr></pc></pr></panel></column><column width='25%'><panel elementName='Card_2'><pr height='fill' width='fill'><pc bgColor='#7F1D1D' padding='18px' width='100%'><pr><pc><text value='CRITICAL SLA WATCHDOG' color='#FCA5A5' size='11px' bold='true' /></pc></pr><pr><pc><text value='Real-Time Priority Scoring' color='#FFFFFF' size='16px' bold='true' /></pc></pr><pr><pc><text value='0-100 Urgency + Landmark Weighting' color='#FECACA' size='12px' /></pc></pr></pc></pr></panel></column><column width='25%'><panel elementName='Card_3'><pr height='fill' width='fill'><pc bgColor='#1E3A8A' padding='18px' width='100%'><pr><pc><text value='SPATIAL DUPLICATE ENGINE' color='#93C5FD' size='11px' bold='true' /></pc></pr><pr><pc><text value='200m Geo-Cluster Merge' color='#FFFFFF' size='16px' bold='true' /></pc></pr><pr><pc><text value='Links duplicates &amp; boosts urgency' color='#BFDBFE' size='12px' /></pc></pr></pc></pr></panel></column><column width='25%'><panel elementName='Card_4'><pr height='fill' width='fill'><pc bgColor='#064E3B' padding='18px' width='100%'><pr><pc><text value='SMART WORKLOAD ROUTER' color='#6EE7B7' size='11px' bold='true' /></pc></pr><pr><pc><text value='Least-Loaded Crew Dispatch' color='#FFFFFF' size='16px' bold='true' /></pc></pr><pr><pc><text value='Ward-level engineer load balancing' color='#A7F3D0' size='12px' /></pc></pr></pc></pr></panel></column></row><row><column width='100%'><report elementName='Main_Triage_Report' reportName='All_Civic_Issues' height='450px' /></column></row><row><column width='50%'><report elementName='Critical_Queue_Report' reportName='Critical_And_Escalated_Issues' height='380px' /></column><column width='50%'><report elementName='Duplicate_Cluster_Report' reportName='AI_Duplicate_Clusters' height='380px' /></column></row><row><column width='50%'><report elementName='Engineer_Roster_Report' reportName='All_Field_Engineers' height='350px' /></column><column width='50%'><report elementName='Audit_Log_Report' reportName='All_Activity_Logs' height='350px' /></column></row></layout></page>"
		}

		page Citizen_Transparency_Portal
		{
			displayname = "Citizen Transparency Portal"
			icon = "world-globe"
			Content = "<page><layout><row><column width='100%'><panel elementName='Citizen_Banner'><pr height='fill' width='fill'><pc bgColor='#0F172A' padding='24px' width='100%'><pr><pc><text value='CIVICLANE PUBLIC ACCOUNTABILITY &amp; COMMUNITY PORTAL' color='#34D399' size='13px' bold='true' /></pc></pr><pr><pc><text value='Transparent Community Issue Tracking, SLA Deadlines &amp; Verified Field Resolutions' color='#FFFFFF' size='20px' bold='true' /></pc></pr></pc></pr></panel></column></row><row><column width='100%'><report elementName='Public_Tracker_Board' reportName='Citizen_Issue_Tracker' height='550px' /></column></row></layout></page>"
		}
	}

	workflow
	{
		form
		{
			Lock_System_Computed_Fields as "Lock Computed AI & SLA Fields on Form Load"
			{
				type = form
				form = Civic_Issues
				record event = on add or edit

				on load
				{
					actions
					{
						custom deluge script
						(
							disable Ticket_Number;
							disable AI_Confidence;
							disable AI_Detected_Objects;
							disable AI_Sentiment;
							disable Priority_Score;
							disable Is_Duplicate;
							disable Master_Issue_Ticket;
							disable Duplicate_Count;
							disable SLA_Deadline;
							disable SLA_Breached;
						)
					}
				}
			}

			Execute_BuiltIn_AI_Pipeline as "Run Built-In AI Classification, Duplicate Clustering & Crew Dispatch"
			{
				type = form
				form = Civic_Issues
				record event = on add

				on validate
				{
					actions
					{
						custom deluge script
						(
							// 1. Invoke Built-In Zoho Creator AI Microservice Engine
							ai_out = thisapp.AI_Microservice.evaluateCivicIssue(input.Issue_Title, input.Issue_Description, input.Landmark_Type, input.Ward_Zone);
							input.AI_Category = ai_out.get("category");
							input.AI_Confidence = ai_out.get("confidence").toDecimal();
							input.AI_Detected_Objects = ai_out.get("detected_tags");
							input.AI_Sentiment = ai_out.get("sentiment");
							computed_score = ai_out.get("priority_score").toLong();

							// 2. Spatial-Semantic Duplicate Detection within ~200m Bounding Box in same Ward
							lat_min = input.Latitude - 0.0020;
							lat_max = input.Latitude + 0.0020;
							lon_min = input.Longitude - 0.0020;
							lon_max = input.Longitude + 0.0020;

							dup_matches = Civic_Issues[Ward_Zone == input.Ward_Zone && AI_Category == input.AI_Category && Is_Duplicate == false && Issue_Status != "Resolved" && Latitude >= lat_min && Latitude <= lat_max && Longitude >= lon_min && Longitude <= lon_max];

							if(dup_matches.count() > 0)
							{
								input.Is_Duplicate = true;
								input.Master_Issue_Ticket = dup_matches.Ticket_Number.toString();
								input.Issue_Status = "Closed - Duplicate";
								input.Priority_Score = computed_score;
								input.Priority_Level = ai_out.get("priority_level");
								input.Duplicate_Count = 1;

								// Boost Master Issue Priority & Duplicate Cluster Count
								updated_count = 2;
								if(dup_matches.Duplicate_Count != null)
								{
									updated_count = dup_matches.Duplicate_Count + 1;
								}
								boosted_master_score = 70;
								if(dup_matches.Priority_Score != null)
								{
									boosted_master_score = dup_matches.Priority_Score + 10;
								}
								if(boosted_master_score > 100)
								{
									boosted_master_score = 100;
								}
								dup_matches.Duplicate_Count = updated_count;
								dup_matches.Priority_Score = boosted_master_score;
								if(boosted_master_score >= 82)
								{
									dup_matches.Priority_Level = "Critical";
								}
								else if(boosted_master_score >= 65)
								{
									dup_matches.Priority_Level = "High";
								}
							}
							else
							{
								input.Is_Duplicate = false;
								input.Duplicate_Count = 1;
								input.Priority_Score = computed_score;
								input.Priority_Level = ai_out.get("priority_level");

								// 3. Automated Department & Least-Loaded Field Engineer Dispatch
								dept_match = Departments[Handled_AI_Category == input.AI_Category && Active_Department == true];
								if(dept_match.count() > 0)
								{
									input.Assigned_Department = dept_match.ID;
									target_hrs = 24;
									if(dept_match.SLA_Target_Hours != null)
									{
										target_hrs = dept_match.SLA_Target_Hours;
									}
									if(input.Priority_Level == "Critical")
									{
										target_hrs = 6;
									}
									input.SLA_Deadline = zoho.currenttime.addHour(target_hrs);

									// Select least-loaded available engineer in Ward
									min_load = 9999;
									chosen_eng_id = 0;
									for each eng_row in Field_Engineers[Department_Ref == dept_match.ID && Primary_Ward == input.Ward_Zone && Availability_Status != "Off Duty"]
									{
										row_load = 0;
										if(eng_row.Current_Active_Load != null)
										{
											row_load = eng_row.Current_Active_Load;
										}
										if(row_load < min_load)
										{
											min_load = row_load;
											chosen_eng_id = eng_row.ID;
										}
									}

									// Fallback to any available engineer in Department if Ward engineer is busy
									if(chosen_eng_id == 0)
									{
										for each eng_fallback in Field_Engineers[Department_Ref == dept_match.ID && Availability_Status != "Off Duty"]
										{
											fb_load = 0;
											if(eng_fallback.Current_Active_Load != null)
											{
												fb_load = eng_fallback.Current_Active_Load;
											}
											if(fb_load < min_load)
											{
												min_load = fb_load;
												chosen_eng_id = eng_fallback.ID;
											}
										}
									}

									if(chosen_eng_id != 0)
									{
										input.Assigned_Engineer = chosen_eng_id;
										input.Issue_Status = "Assigned";
										assigned_eng_rec = Field_Engineers[ID == chosen_eng_id];
										new_load = 1;
										if(assigned_eng_rec.Current_Active_Load != null)
										{
											new_load = assigned_eng_rec.Current_Active_Load + 1;
										}
										assigned_eng_rec.Current_Active_Load = new_load;
										assigned_eng_rec.Availability_Status = "On Field";
									}
									else
									{
										input.Issue_Status = "AI Triaged";
									}
								}
								else
								{
									input.Issue_Status = "AI Triaged";
									input.SLA_Deadline = zoho.currenttime.addHour(24);
								}
							}
						)
					}
				}
			}

			Write_Submission_Audit_Log as "Record AI Microservice Triage Audit Trail"
			{
				type = form
				form = Civic_Issues
				record event = on add

				on success
				{
					actions
					{
						custom deluge script
						(
							if(input.Is_Duplicate == true)
							{
								insert into Issue_Activity_Logs
								[
									Added_User = zoho.loginuser
									Ticket_Ref = "CL-" + input.Ticket_Number.toString()
									Action_Stage = "AI Spatial Duplicate Merged"
									Actor_Details = "Built-In Spatial-Semantic AI Microservice"
									Log_Timestamp = zoho.currenttime
									Audit_Notes = "Matched within 200m of active Master Ticket CL-" + input.Master_Issue_Ticket + ". Clustered report and incremented master priority score."
								];
							}
							else
							{
								insert into Issue_Activity_Logs
								[
									Added_User = zoho.loginuser
									Ticket_Ref = "CL-" + input.Ticket_Number.toString()
									Action_Stage = "AI Triage & Automated Crew Dispatch"
									Actor_Details = "Built-In Zoho AI Classifier & Router"
									Log_Timestamp = zoho.currenttime
									Audit_Notes = "Predicted Category: " + input.AI_Category + " (" + input.AI_Confidence + "% confidence). Tags: [" + input.AI_Detected_Objects + "]. Priority: " + input.Priority_Level + " (" + input.Priority_Score + "/100)."
								];
							}
						)
					}
				}
			}

			Track_Issue_Resolution_And_Workload as "Update Crew Workload & Audit Log on Status Change"
			{
				type = form
				form = Civic_Issues
				record event = on edit

				on success
				{
					actions
					{
						custom deluge script
						(
							if(input.Issue_Status == "Resolved" && old.Issue_Status != "Resolved")
							{
								input.Resolved_On = zoho.currenttime;
								if(input.Assigned_Engineer != null)
								{
									eng_rec = Field_Engineers[ID == input.Assigned_Engineer];
									if(eng_rec.count() > 0)
									{
										updated_load = 0;
										if(eng_rec.Current_Active_Load != null && eng_rec.Current_Active_Load > 1)
										{
											updated_load = eng_rec.Current_Active_Load - 1;
										}
										eng_rec.Current_Active_Load = updated_load;
										if(updated_load == 0)
										{
											eng_rec.Availability_Status = "Available";
										}
									}
								}
								insert into Issue_Activity_Logs
								[
									Added_User = zoho.loginuser
									Ticket_Ref = "CL-" + input.Ticket_Number.toString()
									Action_Stage = "Issue Resolved & Verified"
									Actor_Details = zoho.loginuserid
									Log_Timestamp = zoho.currenttime
									Audit_Notes = "Field repair completed. Resolution Notes: " + ifnull(input.Resolution_Notes,"Verified on site.")
								];
							}
							else if(input.Issue_Status != old.Issue_Status)
							{
								insert into Issue_Activity_Logs
								[
									Added_User = zoho.loginuser
									Ticket_Ref = "CL-" + input.Ticket_Number.toString()
									Action_Stage = "Status Updated: " + old.Issue_Status + " -> " + input.Issue_Status
									Actor_Details = zoho.loginuserid
									Log_Timestamp = zoho.currenttime
									Audit_Notes = "Ticket status transitioned to " + input.Issue_Status
								];
							}
						)
					}
				}
			}

			Run_OneClick_Demo_Seeder as "Seed Complete Municipal & AI Dataset on Submit"
			{
				type = form
				form = Demo_Data_Seeder
				record event = on add

				on success
				{
					actions
					{
						custom deluge script
						(
							seed_status = thisapp.AI_Microservice.populateDemoData(input.Reset_Existing_Data);
							info seed_status;
							openUrl("#Page:CivicLane_Command_Center","same window");
						)
					}
				}
			}
		}

		schedule
		{
			Automated_SLA_Escalation_Watchdog as "Daily SLA Breach Detection & Commissioner Escalation"
			{
				type = schedule
				start = "2026-10-29 00:00:00"
				frequency = daily
				time = "09:00"

				on start
				{
					actions
					{
						custom deluge script
						(
							for each overdue_rec in Civic_Issues[Issue_Status != "Resolved" && Issue_Status != "Closed - Duplicate" && SLA_Breached == false && SLA_Deadline < zoho.currenttime]
							{
								overdue_rec.SLA_Breached = true;
								overdue_rec.Issue_Status = "Escalated";
								overdue_rec.Priority_Level = "Critical";
								esc_score = 90;
								if(overdue_rec.Priority_Score != null)
								{
									esc_score = overdue_rec.Priority_Score + 15;
								}
								if(esc_score > 100)
								{
									esc_score = 100;
								}
								overdue_rec.Priority_Score = esc_score;

								insert into Issue_Activity_Logs
								[
									Added_User = zoho.loginuser
									Ticket_Ref = "CL-" + overdue_rec.Ticket_Number.toString()
									Action_Stage = "Automated SLA Breach Escalation"
									Actor_Details = "Built-In SLA Watchdog Scheduler"
									Log_Timestamp = zoho.currenttime
									Audit_Notes = "Target SLA deadline exceeded. Ticket automatically escalated to Department Commissioner."
								];
							}
						)
					}
				}
			}
		}

		functions
		{
			namespace AI_Microservice
			{
				map evaluateCivicIssue(string title_str, string desc_str, string landmark_str, string ward_str)
				{
					out_map = Map();
					corpus = (ifnull(title_str,"") + " " + ifnull(desc_str,"")).toLowerCase();

					// 1. Built-In Sentiment & Distress Microservice Scoring
					sentiment_tag = "Moderate Concern (Negative)";
					sentiment_weight = 12;
					if(corpus.contains("accident") || corpus.contains("hospital") || corpus.contains("ambulance") || corpus.contains("sparking") || corpus.contains("electrocut") || corpus.contains("burst") || corpus.contains("danger") || corpus.contains("severe"))
					{
						sentiment_tag = "Critical Public Safety Distress";
						sentiment_weight = 24;
					}
					else if(corpus.contains("urgent") || corpus.contains("blocked") || corpus.contains("flooding") || corpus.contains("dark") || corpus.contains("days"))
					{
						sentiment_tag = "High Citizen Urgency";
						sentiment_weight = 18;
					}

					// 2. Built-In Infrastructure Classification & Object Tagging Model
					pred_category = "Public Safety Hazard";
					pred_confidence = 89.4;
					object_tags = "urban_hazard, municipal_inspection";
					base_score = 58;

					if(corpus.contains("pothole") || corpus.contains("asphalt") || corpus.contains("crater") || corpus.contains("road") || corpus.contains("pavement") || corpus.contains("sinkhole"))
					{
						pred_category = "Pothole & Road Damage";
						pred_confidence = 97.2;
						object_tags = "object:pothole, damaged_asphalt, road_cavity";
						base_score = 64;
					}
					else if(corpus.contains("streetlight") || corpus.contains("light") || corpus.contains("pole") || corpus.contains("dark") || corpus.contains("spark") || corpus.contains("cable") || corpus.contains("lamp"))
					{
						pred_category = "Damaged Streetlight";
						pred_confidence = 95.6;
						object_tags = "object:streetlight_pole, luminaire_fault, electrical_box";
						base_score = 58;
					}
					else if(corpus.contains("water") || corpus.contains("leak") || corpus.contains("pipe") || corpus.contains("sewage") || corpus.contains("drain") || corpus.contains("manhole") || corpus.contains("overflow"))
					{
						pred_category = "Water Leakage & Drainage";
						pred_confidence = 96.4;
						object_tags = "object:water_pipeline_leak, surface_waterlogging, drain_blockage";
						base_score = 68;
					}
					else if(corpus.contains("garbage") || corpus.contains("waste") || corpus.contains("trash") || corpus.contains("dump") || corpus.contains("bin") || corpus.contains("sanitation") || corpus.contains("debris"))
					{
						pred_category = "Improper Waste Disposal";
						pred_confidence = 94.8;
						object_tags = "object:garbage_overflow, uncollected_waste, dumpster_full";
						base_score = 52;
					}

					// 3. Landmark Vulnerability Multiplier
					landmark_weight = 6;
					if(landmark_str == "Hospital / Clinic")
					{
						landmark_weight = 22;
					}
					else if(landmark_str == "School / University" || landmark_str == "Highway / Arterial Road")
					{
						landmark_weight = 16;
					}
					else if(landmark_str == "Commercial Market")
					{
						landmark_weight = 11;
					}

					final_score = base_score + sentiment_weight + landmark_weight;
					if(final_score > 100)
					{
						final_score = 100;
					}

					pred_priority = "Medium";
					if(final_score >= 82)
					{
						pred_priority = "Critical";
					}
					else if(final_score >= 65)
					{
						pred_priority = "High";
					}
					else if(final_score < 45)
					{
						pred_priority = "Low";
					}

					out_map.put("category", pred_category);
					out_map.put("confidence", pred_confidence);
					out_map.put("detected_tags", object_tags);
					out_map.put("sentiment", sentiment_tag);
					out_map.put("priority_score", final_score);
					out_map.put("priority_level", pred_priority);
					return out_map;
				}

				string populateDemoData(bool clear_old)
				{
					if(clear_old == true)
					{
						delete from Issue_Activity_Logs[ID != 0];
						delete from Civic_Issues[ID != 0];
						delete from Field_Engineers[ID != 0];
						delete from Departments[ID != 0];
						delete from AI_Model_Dataset[ID != 0];
					}

					// 1. Seed Built-In AI Microservice Training Corpus (for Zoho Creator Prediction & Object Detection Models)
					insert into AI_Model_Dataset
					[
						Added_User = zoho.loginuser
						Sample_Description = "Deep pothole and damaged road asphalt outside hospital emergency gate causing vehicle skids"
						Ward_Zone = "Ward 01 - Central Business District"
						Landmark_Type = "Hospital / Clinic"
						Labeled_Category = "Pothole & Road Damage"
						Vision_Object_Class = "pothole_crater"
						Labeled_Priority = "Critical"
						Historical_Resolution_Hours = 6
					];

					insert into AI_Model_Dataset
					[
						Added_User = zoho.loginuser
						Sample_Description = "Pressurized underground drinking water pipe burst flooding arterial highway intersection"
						Ward_Zone = "Ward 04 - South Tech Park & IT Zone"
						Landmark_Type = "Highway / Arterial Road"
						Labeled_Category = "Water Leakage & Drainage"
						Vision_Object_Class = "water_pipe_rupture"
						Labeled_Priority = "Critical"
						Historical_Resolution_Hours = 8
					];

					insert into AI_Model_Dataset
					[
						Added_User = zoho.loginuser
						Sample_Description = "Broken LED streetlight pole and sparking electrical junction box near school zone"
						Ward_Zone = "Ward 02 - North Residential Zone"
						Landmark_Type = "School / University"
						Labeled_Category = "Damaged Streetlight"
						Vision_Object_Class = "damaged_streetlight"
						Labeled_Priority = "High"
						Historical_Resolution_Hours = 14
					];

					insert into AI_Model_Dataset
					[
						Added_User = zoho.loginuser
						Sample_Description = "Overflowing municipal garbage bins and uncollected solid waste blocking commercial market street"
						Ward_Zone = "Ward 03 - Industrial & Logistics Corridor"
						Landmark_Type = "Commercial Market"
						Labeled_Category = "Improper Waste Disposal"
						Vision_Object_Class = "garbage_overflow"
						Labeled_Priority = "Medium"
						Historical_Resolution_Hours = 16
					];

					// 2. Seed Municipal Departments
					dept_roads = insert into Departments
					[
						Added_User = zoho.loginuser
						Department_Name = "Highways & Road Infrastructure Dept"
						Department_Code = "HRID-01"
						Handled_AI_Category = "Pothole & Road Damage"
						SLA_Target_Hours = 24
						Department_Head_Email = "roads.commissioner@civiclanecity.gov"
						Active_Department = true
					];

					dept_elec = insert into Departments
					[
						Added_User = zoho.loginuser
						Department_Name = "Municipal Electrical & Streetlighting"
						Department_Code = "MESL-02"
						Handled_AI_Category = "Damaged Streetlight"
						SLA_Target_Hours = 18
						Department_Head_Email = "electrical.chief@civiclanecity.gov"
						Active_Department = true
					];

					dept_water = insert into Departments
					[
						Added_User = zoho.loginuser
						Department_Name = "Metro Water Supply & Sewerage Board"
						Department_Code = "MWSS-03"
						Handled_AI_Category = "Water Leakage & Drainage"
						SLA_Target_Hours = 12
						Department_Head_Email = "water.director@civiclanecity.gov"
						Active_Department = true
					];

					dept_waste = insert into Departments
					[
						Added_User = zoho.loginuser
						Department_Name = "Solid Waste & Sanitation Management"
						Department_Code = "SWSM-04"
						Handled_AI_Category = "Improper Waste Disposal"
						SLA_Target_Hours = 16
						Department_Head_Email = "sanitation.head@civiclanecity.gov"
						Active_Department = true
					];

					// 3. Seed Field Engineers
					eng_1 = insert into Field_Engineers
					[
						Added_User = zoho.loginuser
						Engineer_Name = "Arjun Subramanian"
						Engineer_Email = "arjun.s@civiclanecity.gov"
						Engineer_Phone = "+919840112233"
