 application "FreshCheck"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Consumption_Log
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Food_Item
			(
				type = picklist	
				displayname = "Food Item"
				values  = Food_Items.ID
    			displayformat = [Food_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consumption_Date
			(
    			type = date
				displayname = "Consumption Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity_Consumed
			(
				type = decimal
				displayname = "Quantity Consumed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meal_Type
			(
				type = picklist
				displayname = "Meal Type"
				maxchar = 100
				values = {"Breakfast","Lunch","Dinner","Snack","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Food_Items
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Food_Name
			(
    			type = text
				displayname = "Food Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Dairy","Fruit","Vegetable","Meat","Packaged","Bakery","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Brand
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity_Purchased
			(
				type = decimal
				displayname = "Quantity Purchased"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity_Remaining
			(
				type = decimal
				displayname = "Quantity Remaining"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Unit
			(
				type = picklist
				maxchar = 100
				values = {"Pieces","g","kg","ml","L","Pack"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Purchase_Date
			(
    			type = date
				displayname = "Purchase Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Expiry_Date
			(
    			type = date
				displayname = "Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_Price
			(
				displayname = "Unit Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Storage_Location
			(
				type = picklist
				displayname = "Storage Location"
				maxchar = 100
				values = {"Refrigerator","Freezer","Pantry","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expiry_Status
			(
				type = picklist
				displayname = "Expiry Status"
				maxchar = 100
				values = {"Fresh","Expiring Soon","Expired","Consumed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Food_Waste_Log
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Food_Item
			(
				type = picklist	
				displayname = "Food Item"
				values  = Food_Items.ID
    			displayformat = [Food_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Waste_Date
			(
    			type = date
				displayname = "Waste Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity_Wasted
			(
				type = decimal
				displayname = "Quantity Wasted"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Waste_Reason
			(
				type = picklist
				displayname = "Waste Reason"
				maxchar = 100
				values = {"Expired","Spoiled","Leftover","Over-purchased","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Loss
			(
				displayname = "Estimated Loss"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Food_Items_Report
		{
			displayName = "Food_Items Report"
			show all rows from Food_Items    
			(
				Food_Name as "Food Name"
				Category
				Brand
				Quantity_Purchased as "Quantity Purchased"
				Quantity_Remaining as "Quantity Remaining"
				Unit
				Purchase_Date as "Purchase Date"
				Expiry_Date as "Expiry Date"
				Unit_Price as "Unit Price"
				Storage_Location as "Storage Location"
				Expiry_Status as "Expiry Status"
				Notes
			)
		}
		list Expiry_Watchlist
		{
			displayName = "Expiry_Watchlist"
			show all rows from Food_Items  [Expiry_Date in next 3 days && Expiry_Status != "Consumed"]  
			(
				Food_Name as "Food Name"
				Category
				Brand
				Quantity_Purchased as "Quantity Purchased"
				Quantity_Remaining as "Quantity Remaining"
				Unit
				Purchase_Date as "Purchase Date"
				Expiry_Date as "Expiry Date"
				Unit_Price as "Unit Price"
				Storage_Location as "Storage Location"
				Expiry_Status as "Expiry Status"
				Notes
			)
		}
		default list Consumption_Log_Report
		{
			displayName = "Consumption_Log Report"
			show all rows from Consumption_Log    
			(
				Food_Item as "Food Item"
				Consumption_Date as "Consumption Date"
				Quantity_Consumed as "Quantity Consumed"
				Meal_Type as "Meal Type"
				Notes
			)
		}
		default list Food_Waste_Log_Report
		{
			displayName = "Food_Waste_Log Report"
			show all rows from Food_Waste_Log    
			(
				Food_Item as "Food Item"
				Waste_Date as "Waste Date"
				Quantity_Wasted as "Quantity Wasted"
				Waste_Reason as "Waste Reason"
				Estimated_Loss as "Estimated Loss"
				Notes
			)
		}
	}
