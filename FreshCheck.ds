='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Consumption_Log.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Consumption Records'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='32%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#BC2AE7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Food_Waste_Log.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Food Waste Records'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Update_Expiry_Status as "Update_Expiry_Status"
			{
				type =  form
				form = Food_Items

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity_Remaining <= 0)
										{
											input.Expiry_Status = "Consumed";
										}
										else if(input.Expiry_Date < zoho.currentdate)
										{
											input.Expiry_Status = "Expired";
										}
										else if(input.Expiry_Date <= zoho.currentdate.addDay(3))
										{
											input.Expiry_Status = "Expiring Soon";
										}
										else
										{
											input.Expiry_Status = "Fresh";
										}
						)
					}
				}

			}
			Update_Quantity_After_Con as "Update_Quantity_After_Consumption"
			{
				type =  form
				form = Consumption_Log

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											foodRecord = Food_Items[ID == input.Food_Item];
										if(foodRecord.count() > 0)
										{
											newQuantity = foodRecord.Quantity_Remaining - input.Quantity_Consumed;
											if(newQuantity >= 0)
											{
												foodRecord.Quantity_Remaining=newQuantity;
												if(newQuantity <= 0)
												{
													foodRecord.Expiry_Status="Consumed";
												}
												else if(foodRecord.Expiry_Date < zoho.currentdate)
												{
													foodRecord.Expiry_Status="Expired";
												}
												else if(foodRecord.Expiry_Date <= zoho.currentdate.addDay(3))
												{
													foodRecord.Expiry_Status="Expiring Soon";
												}
												else
												{
													foodRecord.Expiry_Status="Fresh";
												}
											}
										}
						)
					}
				}

			}
			Validate_Waste_Entry as "Validate_Waste_Entry"
			{
				type =  form
				form = Food_Waste_Log

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity_Wasted <= 0)
										{
											alert "Quantity wasted must be greater than zero.";
											cancel submit;
										}
										else if(input.Food_Item != null)
										{
											food_record = Food_Items[ID == input.Food_Item];
											if(food_record.ID != null)
											{
												if(input.Quantity_Wasted > food_record.Quantity_Remaining)
												{
													alert "Quantity wasted cannot exceed the remaining quantity.";
													cancel submit;
												}
												else
												{
													input.Estimated_Loss = input.Quantity_Wasted * food_record.Unit_Price;
												}
											}
										}
						)
					}
				}

			}
			Update_Stock_After_Waste as "Update_Stock_After_Waste"
			{
				type =  form
				form = Food_Waste_Log

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											food_record = Food_Items[ID == input.Food_Item];
										if(food_record.ID != null)
										{
											remaining_qty = ifnull(food_record.Quantity_Remaining,0);
											waste_qty = ifnull(input.Quantity_Wasted,0);
											if(waste_qty > 0 && waste_qty <= remaining_qty)
											{
												food_record.Quantity_Remaining=remaining_qty - waste_qty;
											}
										}
						)
					}
				}

			}
			Validate_Consumption_Quan as "Validate_Consumption_Quantity"
			{
				type =  form
				form = Consumption_Log

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity_Consumed <= 0)
										{
											alert "Quantity consumed must be greater than zero.";
											cancel submit;
										}
										if(input.Food_Item != null)
										{
											food_record = Food_Items[ID == input.Food_Item];
											if(food_record.ID != null)
											{
												remaining_qty = ifnull(food_record.Quantity_Remaining,0);
												if(input.Quantity_Consumed > remaining_qty)
												{
													alert "Quantity consumed cannot exceed the remaining stock.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
		}






	}
